# =============================================================================
# MEGA AI — Environment Configuration Template
# =============================================================================
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in your actual API keys below
# 3. NEVER commit .env to git — it is already in .gitignore
# =============================================================================

# --- LLM Configuration (The ONLY place model is configured) -------------------

# Primary provider: gemini, groq, deepseek, anthropic
LLM_PROVIDER=gemini

# Model identifier — must match provider's naming convention
LLM_MODEL=gemini-2.5-flash

# Your API key for the primary provider
LLM_API_KEY=your_gemini_api_key_here

# Fallback provider (used on primary timeout/rate-limit)
FALLBACK_PROVIDER=groq
FALLBACK_MODEL=llama-3.3-70b-versatile
FALLBACK_API_KEY=your_groq_api_key_here

# Optional: tertiary provider for critical paths
TERTIARY_PROVIDER=deepseek
TERTIARY_MODEL=deepseek-v4-pro
TERTIARY_API_KEY=your_deepseek_api_key_here

# --- Database Configuration --------------------------------------------------

POSTGRES_USER=megaai
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=megaai
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# --- Redis Configuration (Celery broker + result backend) --------------------

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# --- Application Configuration -----------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Max tokens per agent context window (default 8k)
DEFAULT_CONTEXT_BUDGET=8192

# Enable/disable specific agents (comma-separated list)
ENABLED_AGENTS=orchestrator,decomposition,rag,critique,synthesis,compression,meta

# Evaluation settings
EVAL_MAX_RETRIES=2
EVAL_TIMEOUT_SECONDS=300

# --- Security ----------------------------------------------------------------

# API key for log UI access (leave empty to disable auth)
LOG_UI_API_KEY=your_log_ui_key_here

# CORS origins (comma-separated, no spaces)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Feature Flags -----------------------------------------------------------

# Enable self-improving loop (prompt rewrite proposals)
ENABLE_META_AGENT=true

# Enable adversarial testing in evaluation
ENABLE_ADVERSARIAL_TESTS=true

# Enable context compression agent
ENABLE_COMPRESSION=true

# Enable SSE streaming endpoints
ENABLE_SSE_STREAMING=true
